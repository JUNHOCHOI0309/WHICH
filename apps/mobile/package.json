{
  "name": "@which/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir dist",
    "dev": "expo start",
    "dev:client": "expo start --dev-client --tunnel",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "start": "expo start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.3",
    "eslint-config-expo": "~57.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }

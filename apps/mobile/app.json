{
  "expo": {
    "name": "WHICH",
    "slug": "which-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "which",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "site.whichone.app",
      "supportsTablet": true
    },
    "android": {
      "package": "site.whichone.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WHICH 프로필 이미지를 선택하기 위해 사진 접근 권한을 사용합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dce1e222-2963-4395-a59b-f495420a4e1b"
      }
    }
  }
}

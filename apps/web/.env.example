# WHICH API (server-only Web BFF connection)
API_BASE_URL=http://localhost:4000

# Member session bridge
# Must exactly match INTERNAL_AUTH_SECRET in the repository root .env file.
AUTH_INTERNAL_SECRET=replace-with-the-same-value-as-INTERNAL_AUTH_SECRET
# Use a separate random value with at least 32 characters.
AUTH_FLOW_SECRET=replace-with-a-separate-at-least-32-character-random-secret
# Optional: when omitted, AUTH_FLOW_SECRET is reused with a separate HMAC context.
ANALYTICS_SESSION_SECRET=
AUTH_BASE_URL=http://localhost:3000

# Google OAuth 2.0 + OpenID Connect
# Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# X OAuth 2.0 Authorization Code + PKCE
# Callback: http://localhost:3000/api/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Naver OpenID Connect Authorization Code + PKCE
# Callback: http://localhost:3000/api/auth/naver/callback
FEATURE_NAVER_LOGIN_ENABLED=false
NAVER_OIDC_CLIENT_ID=
NAVER_OIDC_CLIENT_SECRET=

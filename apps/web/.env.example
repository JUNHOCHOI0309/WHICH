# WHICH API (server-only Web BFF connection)
API_BASE_URL=http://localhost:4000

# Member session bridge
# Optional Web-specific alias. If omitted, the BFF uses INTERNAL_AUTH_SECRET.
# When both exist, this must exactly match INTERNAL_AUTH_SECRET in the API environment.
AUTH_INTERNAL_SECRET=replace-with-the-same-value-as-INTERNAL_AUTH_SECRET
# Use a separate random value with at least 32 characters.
AUTH_FLOW_SECRET=replace-with-a-separate-at-least-32-character-random-secret
# Optional: when omitted, AUTH_FLOW_SECRET is reused with a separate HMAC context.
ANALYTICS_SESSION_SECRET=
# Optional. Set a separate random secret only when operator/test browser sessions must be
# deliberately excluded from official Product metrics. Never expose it to client JavaScript.
ANALYTICS_EXCLUSION_SECRET=
AUTH_BASE_URL=http://localhost:3000

# Transactional email (server-only)
# Production sender must be verified by Resend, e.g. WHICH <auth@whichone.site>.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@whichone.site

# Cloudflare R2 profile images (server-only)
# Public base can be an R2 custom domain such as https://images.whichone.site.
# When any value is omitted, avatar upload and social-image caching stay unavailable
# without affecting login or the rest of the Web service.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Google OAuth 2.0 + OpenID Connect
# Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# X OAuth 2.0 Authorization Code + PKCE
# Callback: http://localhost:3000/api/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Naver OpenID Connect Authorization Code + PKCE
# Callback: http://localhost:3000/api/auth/naver/callback
FEATURE_NAVER_LOGIN_ENABLED=false
NAVER_OIDC_CLIENT_ID=
NAVER_OIDC_CLIENT_SECRET=

# Kakao OpenID Connect Authorization Code + PKCE
# Callback: http://localhost:3000/api/auth/kakao/callback
FEATURE_KAKAO_LOGIN_ENABLED=false
KAKAO_OIDC_CLIENT_ID=
KAKAO_OIDC_CLIENT_SECRET=

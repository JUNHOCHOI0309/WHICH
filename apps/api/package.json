{
  "name": "@which/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/outbox-worker.ts --format esm --platform node --target node22 --clean --sourcemap",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "outbox:dead-letters": "tsx src/outbox-worker.ts dead-letters",
    "outbox:publish-once": "tsx src/outbox-worker.ts once",
    "outbox:requeue": "tsx src/outbox-worker.ts requeue",
    "outbox:worker": "tsx src/outbox-worker.ts run",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.3",
    "globals": "17.11.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}

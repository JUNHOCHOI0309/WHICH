{
  "name": "@which/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/outbox-worker.ts src/moderation-worker.ts src/point-worker.ts src/point-operator.ts src/launch-gate.ts src/issue-publisher.ts src/analytics-operator.ts src/beta-operator.ts src/ops-operator.ts --format esm --platform node --target node22 --clean --sourcemap",
    "analytics:aggregate": "tsx src/analytics-operator.ts aggregate",
    "analytics:retention": "tsx src/analytics-operator.ts retention",
    "analytics:summary": "tsx src/analytics-operator.ts summary",
    "analytics:quality": "tsx src/analytics-operator.ts quality",
    "analytics:reconcile": "tsx src/analytics-operator.ts reconcile",
    "analytics:baseline": "tsx src/analytics-operator.ts baseline",
    "beta:review": "tsx src/beta-operator.ts review",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "launch:gate": "tsx src/launch-gate.ts run",
    "launch:public-smoke": "tsx src/launch-gate.ts public",
    "launch:rollback-snapshot": "tsx src/launch-gate.ts snapshot",
    "launch:rollback-verify": "tsx src/launch-gate.ts verify",
    "issues:validate": "tsx src/issue-publisher.ts validate",
    "issues:dry-run": "tsx src/issue-publisher.ts dry-run",
    "issues:publish": "tsx src/issue-publisher.ts publish",
    "issues:readiness": "tsx src/issue-publisher.ts readiness",
    "issues:build": "tsx src/issue-pack-builder.ts",
    "issues:review": "tsx src/editorial-review-console.ts",
    "outbox:dead-letters": "tsx src/outbox-worker.ts dead-letters",
    "outbox:publish-once": "tsx src/outbox-worker.ts once",
    "outbox:requeue": "tsx src/outbox-worker.ts requeue",
    "outbox:worker": "tsx src/outbox-worker.ts run",
    "moderation:once": "tsx src/moderation-worker.ts once",
    "moderation:worker": "tsx src/moderation-worker.ts run",
    "moderation:dead-letters": "tsx src/moderation-worker.ts dead-letters",
    "moderation:requeue": "tsx src/moderation-worker.ts requeue",
    "moderation:reconcile-media": "tsx src/moderation-worker.ts reconcile-media",
    "points:consume-once": "tsx src/point-worker.ts once",
    "points:worker": "tsx src/point-worker.ts run",
    "points:worker:prod": "node dist/point-worker.js run",
    "points:reconcile": "tsx src/point-operator.ts reconcile",
    "points:repair": "tsx src/point-operator.ts repair",
    "points:reversals": "tsx src/point-operator.ts reversals",
    "points:apply-reversals": "tsx src/point-operator.ts apply-reversals",
    "points:adjust": "tsx src/point-operator.ts adjust",
    "points:ledger": "tsx src/point-operator.ts ledger",
    "ops:grant": "tsx src/ops-operator.ts grant",
    "ops:revoke": "tsx src/ops-operator.ts revoke",
    "ops:list": "tsx src/ops-operator.ts list",
    "ops:confirm-backup": "tsx src/ops-operator.ts confirm-backup",
    "ops:import-editorial": "tsx src/ops-operator.ts import-editorial",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@fastify/cors": "11.3.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.1.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "pg": "8.23.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.3",
    "globals": "17.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}

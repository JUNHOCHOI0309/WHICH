{
  "name": "which",
  "version": "0.0.0",
  "private": true,
  "description": "WHICH product monorepo",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.6.5 <11"
  },
  "scripts": {
    "radar:setup": "node scripts/local-radar/run.mjs setup",
    "radar:dev": "node scripts/local-radar/run.mjs dev",
    "radar:db:stop": "node scripts/local-radar/run.mjs stop-db",
    "radar:test": "node --test scripts/local-radar/profile.test.mjs",
    "radar:test:db": "node scripts/local-radar/run.mjs test-db",
    "radar:migrate": "node scripts/local-radar/run.mjs migrate",
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "dev": "turbo run dev --parallel",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.10"
  }
}

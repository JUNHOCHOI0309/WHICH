# Local PostgreSQL
POSTGRES_DB=which
POSTGRES_USER=which
POSTGRES_PASSWORD=which_local
POSTGRES_PORT=54329
DATABASE_URL=postgresql://which:which_local@localhost:54329/which

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
INTERNAL_AUTH_SECRET=replace-with-at-least-16-random-characters
MODERATION_INTERNAL_SECRET=replace-with-a-different-random-secret
MEMBER_SESSION_TTL_SECONDS=604800

# Initial release flags: all optional capabilities remain disabled.
FEATURE_COMMENTS_ENABLED=false
FEATURE_CREATOR_SUBMISSIONS_ENABLED=false
FEATURE_ML_RANKER_ENABLED=false
FEATURE_RESULT_SHARING_ENABLED=false
FEATURE_RISK_CHALLENGE_ENABLED=false

# Web BFF values are loaded from apps/web/.env.local by Next.js.
# Copy apps/web/.env.example to apps/web/.env.local and fill provider credentials there.

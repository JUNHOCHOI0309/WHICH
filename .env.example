# Local PostgreSQL
POSTGRES_DB=which
POSTGRES_USER=which
POSTGRES_PASSWORD=which_local
POSTGRES_PORT=54329
DATABASE_URL=postgresql://which:which_local@localhost:54329/which

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RELEASE_ID=local
INTERNAL_AUTH_SECRET=replace-with-at-least-16-random-characters
MODERATION_INTERNAL_SECRET=replace-with-a-different-random-secret
MEMBER_SESSION_TTL_SECONDS=604800
MOBILE_AUTH_TICKET_TTL_SECONDS=300
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_SIGNUP_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_EMAIL_DELIVERY_RATE_LIMIT=3
AUTH_TOKEN_CONSUME_RATE_LIMIT=10
# Keep false until the production sender is configured and existing credentials have a verification path.
AUTH_EMAIL_VERIFICATION_REQUIRED=false

# Operator dashboard. Leave both Cloudflare values empty for local development.
# Production /ops should set both values and protect /ops* + /api/ops/* in Cloudflare Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
OPS_CHANGE_ACTOR=

# Cloudflare R2 profile images (used by the Web BFF only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Operator Issue media (API only). Staging must remain private and use a different bucket.
R2_ISSUE_MEDIA_STAGING_BUCKET=
R2_ISSUE_MEDIA_PUBLISHED_BUCKET=
R2_ISSUE_MEDIA_PUBLIC_BASE_URL=

# Outbox Worker (required only when running outbox:* publish commands)
OUTBOX_WEBHOOK_URL=https://events.example.com/which
OUTBOX_WEBHOOK_SECRET=replace-with-a-different-random-secret
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
OUTBOX_HTTP_TIMEOUT_MS=5000

# Moderation Shadow Worker. An API key alone never enables provider traffic.
MODERATION_WORKER_BATCH_SIZE=25
MODERATION_WORKER_LEASE_MS=60000
MODERATION_WORKER_MAX_ATTEMPTS=5
MODERATION_WORKER_RETRY_BASE_MS=5000
MODERATION_WORKER_RETRY_MAX_MS=300000
MODERATION_WORKER_POLL_MS=2000
MODERATION_PROVIDER_MODE=OFF
MODERATION_PROVIDER=OPENAI_MODERATION
MODERATION_PROVIDER_KILL_SWITCH=true
MODERATION_PROVIDER_CANARY_PERCENT=0
MODERATION_PROVIDER_DAILY_CALL_CAP=0
MODERATION_PROVIDER_DAILY_COST_MICROS_CAP=0
MODERATION_PROVIDER_CIRCUIT_WINDOW_MINUTES=5
MODERATION_PROVIDER_CIRCUIT_MIN_CALLS=5
MODERATION_PROVIDER_CIRCUIT_FAILURE_PERCENT=50
MODERATION_PROVIDER_APPROVAL_EVIDENCE=
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-2024-09-26
OPENAI_MODERATION_TIMEOUT_MS=10000

# Decision Engine. LIMITED_ACTION remains inert until category, canary, budget and release gates pass.
MODERATION_DECISION_MODE=OFF
MODERATION_DECISION_KILL_SWITCH=true
MODERATION_DECISION_CANARY_PERCENT=0
MODERATION_DECISION_CATEGORY_FLAGS=
MODERATION_PROVISIONAL_RELEASE_APPROVED=false
MODERATION_PROVISIONAL_COHORTS=
MODERATION_PROVISIONAL_ASSET_TYPES=
MODERATION_QUARANTINE_TTL_SECONDS=86400
MODERATION_PROVISIONAL_TTL_SECONDS=21600

# Public MVP Gate (replace release and Issue values for staging/production)
LAUNCH_GATE_TARGET_ENVIRONMENT=development
LAUNCH_GATE_API_URL=http://localhost:4000
LAUNCH_GATE_PUBLIC_WEB_URL=http://localhost:3000
LAUNCH_GATE_EXPECTED_RELEASE_ID=local
LAUNCH_GATE_OUTBOX_DELIVERY_REQUIRED=true
LAUNCH_GATE_ISSUE_ID=10000000-0000-4000-8000-000000000001
LAUNCH_GATE_ISSUE_VERSION=1
LAUNCH_GATE_MAX_DEAD_LETTERS=0
LAUNCH_GATE_MAX_PENDING_AGE_SECONDS=300

# Initial release flags: all optional capabilities remain disabled.
FEATURE_COMMENTS_ENABLED=false
FEATURE_CREATOR_SUBMISSIONS_ENABLED=false
FEATURE_ML_RANKER_ENABLED=false
FEATURE_RESULT_SHARING_ENABLED=false
FEATURE_ISSUE_MEDIA_ENABLED=false
# Stable viewer percentage assigned to approved OPTION_IMAGES cards. Set 0 for instant rollback.
ISSUE_MEDIA_EXPERIMENT_PERCENT=0
ISSUE_MEMBER_MEDIA_UPLOAD_MODE=OFF
ISSUE_MEDIA_RULE_GATE_MODE=ENFORCE
# Local OCR/QR/barcode scanner. Enable only after host CPU/RSS and timeout checks.
ISSUE_MEDIA_LOCAL_SCANNER_MODE=OFF
ISSUE_MEDIA_LOCAL_SCANNER_TIMEOUT_MS=15000
ISSUE_MEDIA_CONSENT_VERSION=which-media-consent-v1
QUALITY_RANKER_MODE=SHADOW
FEATURE_POINTS_ENABLED=false
FEATURE_RISK_CHALLENGE_ENABLED=false

# Web BFF values are loaded from apps/web/.env.local by Next.js.
# Email verification and password reset additionally require RESEND_API_KEY and AUTH_EMAIL_FROM there.
# Copy apps/web/.env.example to apps/web/.env.local and fill Google, X, Naver, and Kakao credentials there.
# Keep FEATURE_NAVER_LOGIN_ENABLED=false until Naver credentials and review are ready.
# Keep FEATURE_KAKAO_LOGIN_ENABLED=false until Kakao credentials and real callback QA are ready.

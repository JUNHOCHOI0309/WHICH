# Local PostgreSQL
POSTGRES_DB=which
POSTGRES_USER=which
POSTGRES_PASSWORD=which_local
POSTGRES_PORT=54329
DATABASE_URL=postgresql://which:which_local@localhost:54329/which

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
INTERNAL_AUTH_SECRET=replace-with-at-least-16-random-characters
MEMBER_SESSION_TTL_SECONDS=604800

# Initial release flags: all optional capabilities remain disabled.
FEATURE_COMMENTS_ENABLED=false
FEATURE_CREATOR_SUBMISSIONS_ENABLED=false
FEATURE_ML_RANKER_ENABLED=false
FEATURE_RESULT_SHARING_ENABLED=false
FEATURE_RISK_CHALLENGE_ENABLED=false

# Web (copy this value to apps/web/.env.local only when overriding the default)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Google OIDC (Web BFF). Keep these server-only; never prefix them with NEXT_PUBLIC_.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
AUTH_INTERNAL_SECRET=replace-with-the-same-value-as-INTERNAL_AUTH_SECRET
AUTH_FLOW_SECRET=replace-with-a-separate-at-least-32-character-random-secret
AUTH_BASE_URL=http://localhost:3000

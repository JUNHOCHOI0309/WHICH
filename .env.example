# Local PostgreSQL
POSTGRES_DB=which
POSTGRES_USER=which
POSTGRES_PASSWORD=which_local
POSTGRES_PORT=54329
DATABASE_URL=postgresql://which:which_local@localhost:54329/which

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RELEASE_ID=local
INTERNAL_AUTH_SECRET=replace-with-at-least-16-random-characters
MODERATION_INTERNAL_SECRET=replace-with-a-different-random-secret
MEMBER_SESSION_TTL_SECONDS=604800

# Outbox Worker (required only when running outbox:* publish commands)
OUTBOX_WEBHOOK_URL=https://events.example.com/which
OUTBOX_WEBHOOK_SECRET=replace-with-a-different-random-secret
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
OUTBOX_HTTP_TIMEOUT_MS=5000

# Public MVP Gate (replace release and Issue values for staging/production)
LAUNCH_GATE_TARGET_ENVIRONMENT=development
LAUNCH_GATE_API_URL=http://localhost:4000
LAUNCH_GATE_PUBLIC_WEB_URL=http://localhost:3000
LAUNCH_GATE_EXPECTED_RELEASE_ID=local
LAUNCH_GATE_OUTBOX_DELIVERY_REQUIRED=true
LAUNCH_GATE_ISSUE_ID=10000000-0000-4000-8000-000000000001
LAUNCH_GATE_ISSUE_VERSION=1
LAUNCH_GATE_MAX_DEAD_LETTERS=0
LAUNCH_GATE_MAX_PENDING_AGE_SECONDS=300

# Initial release flags: all optional capabilities remain disabled.
FEATURE_COMMENTS_ENABLED=false
FEATURE_CREATOR_SUBMISSIONS_ENABLED=false
FEATURE_ML_RANKER_ENABLED=false
FEATURE_RESULT_SHARING_ENABLED=false
FEATURE_RISK_CHALLENGE_ENABLED=false

# Web BFF values are loaded from apps/web/.env.local by Next.js.
# Copy apps/web/.env.example to apps/web/.env.local and fill provider credentials there.
